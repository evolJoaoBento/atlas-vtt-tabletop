{
  "name": "atlas-vtt-tabletop",
  "version": "1.3.0",
  "private": true,
  "description": "Atlas VTT extension: stand 3D GLB minis on tokens, with a gallery to import them; shared with players over Atlas VTT Connect.",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node tests/run.mjs",
    "deploy": "node esbuild.config.mjs production && node scripts/deploy.mjs",
    "sync:dice": "node scripts/sync-dice-kit.mjs",
    "check:atlas": "node scripts/check-atlas-members.mjs",
    "test:ui": "node harness/run-ui.mjs",
    "test:ui:all": "node harness/run-ui.mjs --all",
    "sync:atlas": "node scripts/sync-atlas-port.mjs",
    "sync:connect": "node scripts/sync-connect.mjs",
    "check:connect": "node scripts/sync-connect.mjs --check"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.185.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.14.21",
    "cannon-es": "^0.20.0",
    "clipper2-ts": "^2.0.1-18",
    "clsx": "2.1.1",
    "framer-motion": "12.7.4",
    "lucide-react": "0.503.0",
    "meshoptimizer": "^1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "^0.185.1",
    "yaml": "2.9.1",
    "zustand": "5.0.3"
  },
  "overrides": {
    "motion-dom": "12.7.4",
    "motion-utils": "12.7.2"
  }
}
